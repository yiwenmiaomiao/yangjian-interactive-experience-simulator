# Photon (花奇) iMessage 平台
PHOTON_PROJECT_ID=your-project-id
PHOTON_PROJECT_SECRET=your-project-secret
PHOTON_ALLOWED_USERS=+86your-phone-number
PHOTON_HOME_CHANNEL=+86your-phone-number
PHOTON_MARKDOWN=true
PHOTON_SIDECAR_PORT=8789
PHOTON_SIDECAR_AUTOSTART=true
PHOTON_SIDECAR_TOKEN=your-sidecar-token

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key

# 代理
http_proxy=http://127.0.0.1:7890
https_proxy=http://127.0.0.1:7890
no_proxy=localhost,127.0.0.1,::1,*.local,photon.codes,spectrum.photon.codes

# MiniMax API（可选）
MINIMAX_API_KEY=your-minimax-api-key

# Langfuse（可选）
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://us.cloud.langfuse.com
